DSC_LIVE_ENVIRONMENT=production
DSC_LIVE_API_URL=https://wetuhtamrg.execute-api.ap-northeast-2.amazonaws.com/dev
DSC_LIVE_TOKEN_URL=https://REPLACE_DOMAIN.auth.ap-northeast-2.amazoncognito.com/oauth2/token
DSC_LIVE_CLIENT_ID=REPLACE_REGISTERED_FIELD_CLIENT
DSC_LIVE_SECRET_FILE=/etc/dsc/field-client-secret
DSC_LIVE_OAUTH_ORIGIN=https://REPLACE_DOMAIN.auth.ap-northeast-2.amazoncognito.com
DSC_LIVE_STAFF_CLIENT_ID=REPLACE_PUBLIC_STAFF_CLIENT
DSC_LIVE_BROWSER_ORIGIN=https://live.example.internal
DSC_LIVE_ALLOWED_GATEWAY_ORIGINS='["https://live.example.internal"]'
DSC_LIVE_STATE_DIR=/var/lib/dsc/live
DSC_LIVE_MEDIAMTX_CONFIG=/etc/dsc/mediamtx.json
DSC_LIVE_POLL_SECONDS=5
DSC_LIVE_MAX_PEERS=32
