DSC_EDGE_ROLE=archive
DSC_EDGE_SERVER_ID=office-site-1
DSC_EDGE_SITE_ID=site-1
DSC_EDGE_API_URL=https://api.example.invalid
DSC_EDGE_TOKEN_URL=https://example.auth.ap-northeast-2.amazoncognito.com/oauth2/token
DSC_EDGE_CLIENT_ID=REPLACE_OFFICE_CLIENT_ID
