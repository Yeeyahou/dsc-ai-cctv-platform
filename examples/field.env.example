DSC_EDGE_TOKEN_URL=https://example.auth.ap-northeast-2.amazoncognito.com/oauth2/token
DSC_EDGE_CLIENT_ID=REPLACE_PER_INSTALLATION_CLIENT_ID
DSC_EDGE_SECRET_FILE=/etc/dsc/cctv-client-secret
DSC_EDGE_NAS_ROOT=/var/spool/dsc/cctv-clips
