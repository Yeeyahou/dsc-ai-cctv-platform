DSC_EDGE_ENVIRONMENT=production
DSC_EDGE_AGENT_ID=agent-initial
DSC_EDGE_SITE_ID=incheon-01
DSC_EDGE_API_URL=https://dsc.f2x.ai
DSC_EDGE_TOKEN_URL=https://REPLACE_DOMAIN.auth.ap-northeast-2.amazoncognito.com/oauth2/token
DSC_EDGE_CLIENT_ID=REPLACE_EDGE_CLIENT_ID
DSC_EDGE_SECRET_FILE=/etc/dsc/client-secret
DSC_EDGE_NAS_ROOT=/mnt/dsc-nas
DSC_EDGE_STATE_DIR=/var/lib/dsc
DSC_EDGE_INBOX=/var/spool/dsc
